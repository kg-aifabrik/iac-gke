# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local credentials must never be committed (defense in depth; WIF means there
# are normally none, but guard against accidental key files / ADC dumps).
*.json.key
gha-creds-*.json
application_default_credentials.json

# Terraform — provider binaries and state are not committed; the lock file IS,
# but only at the root modules under envs/ where `terraform init` runs. Locks
# inside reusable modules are spurious (init never consults them) — ignore them
# so a stray `terraform init`/`validate` inside a module dir can't recommit one.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
terraform/modules/**/.terraform.lock.hcl
crash.log
# Real variable files carry account-specific values (project ids); only the
# committed *.example templates are tracked.
*.tfvars
*.tfvars.local
!*.tfvars.example

# OS / editor
.DS_Store
